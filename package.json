{
  "name": "app-lycee",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "supabase test db",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "import:contenu": "tsx --env-file=.env.local scripts/importer-contenu.ts",
    "cles:notifications": "tsx scripts/cles-notifications.ts",
    "configurer:envoi": "tsx --env-file=.env.local scripts/configurer-envoi.ts",
    "db:reset": "supabase db reset && npm run import:contenu -- contenu/1re-st2s/bph.json --publier && npm run configurer:envoi"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
